# E2E environment — loaded by `npm test` via `dotenv -e .env.e2e -- playwright test`.
#
# These override .env.local ONLY for the test run (dotenv-cli injects them into
# process.env; Next.js does not overwrite already-set vars, so local wins over Neon).
# Everything NOT listed here is inherited from .env.local by the dev server as usual.
#
# No secrets: this is the throwaway local Postgres from scripts/e2e-db.mjs.
# playwright.config.ts REFUSES to run unless DATABASE_URL points at localhost.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/tennis
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:54329/tennis

# Dedicated dev server for the suite (never the normal `npm run dev` on 3000).
E2E_PORT=3100

# Separate build dir so the e2e dev server's lock (.next-e2e/dev/lock) doesn't
# collide with a normal `next dev` running on .next (Next 16 single dev lock).
NEXT_DIST_DIR=.next-e2e
