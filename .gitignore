# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/.e2e-report/

# next.js
/.next/
/.next-e2e/
/.next-e2e-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.local holds the Neon connection string; never commit it.
# The two exceptions carry no secrets (template + local-only e2e values).
.env*
!.env.local.example
!.env.e2e

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
