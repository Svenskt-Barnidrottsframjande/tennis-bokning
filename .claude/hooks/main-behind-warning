#!/bin/sh
# SessionStart hook: warn when local `main` is behind `origin/main`. Parallel
# worktree agents push straight to origin/main, and the main checkout does not
# update itself (2026-10-03: main sat 3 commits behind after Plans 176–178).
# Also names untracked files that the pull would overwrite (stale plan drafts),
# since `git pull` refuses until they are moved. Silent when up to date or offline.
cd "$CLAUDE_PROJECT_DIR" 2>/dev/null || exit 0
git rev-parse --verify -q origin/main >/dev/null || exit 0

# Fetch with a 5s cap (macOS has no `timeout`); a slow or offline fetch just
# means we compare against the last-known origin/main.
GIT_TERMINAL_PROMPT=0 git fetch -q origin main >/dev/null 2>&1 &
pid=$!
i=0
while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 10 ]; do sleep 0.5; i=$((i + 1)); done
kill "$pid" 2>/dev/null

behind=$(git rev-list --count main..origin/main 2>/dev/null)
[ -n "$behind" ] && [ "$behind" -gt 0 ] || exit 0

blockers=""
if [ "$(git branch --show-current)" = "main" ]; then
  incoming=$(git diff --name-only main origin/main)
  for f in $(git ls-files --others --exclude-standard); do
    printf '%s\n' "$incoming" | grep -qxF "$f" && blockers="$blockers $f"
  done
fi

msg="⚠️ local main is $behind commit(s) behind origin/main (another agent pushed). Pull before working: git -C $CLAUDE_PROJECT_DIR pull --ff-only"
ctx="Local branch main is $behind commit(s) behind origin/main — usually a parallel worktree agent pushed without the main checkout pulling. Tell the user in your first reply and offer to fast-forward (git pull --ff-only, then npm install if package.json changed) before doing substantive work. See 'Parallel worktree agents' in AGENTS.md."
if [ -n "$blockers" ]; then
  msg="$msg — untracked files block the pull:$blockers"
  ctx="$ctx These untracked files also exist in the incoming commits and will block the pull:$blockers. Compare each against its origin/main version before removing it; never delete one that has content missing from origin."
fi

# Minimal JSON escaping: only " and \ can appear in these strings.
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
printf '{"systemMessage": "%s", "hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "%s"}}\n' "$(esc "$msg")" "$(esc "$ctx")"
exit 0
