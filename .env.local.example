# Copy to .env.local and fill in. Only Next.js auto-loads .env.local; the db:* scripts
# load it through dotenv-cli (see package.json).

# Neon Postgres. With the Vercel Marketplace integration: `vercel env pull .env.local`
# writes both of these for you (DATABASE_URL is the pooled endpoint the app uses,
# DATABASE_URL_UNPOOLED the direct endpoint drizzle-kit uses for migrations).
# Hand-made Neon project: Dashboard → Connect → copy the pooled + direct strings.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
